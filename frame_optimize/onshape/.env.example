# Onshape OAuth2 credentials
# 1. https://cad.onshape.com/appstore/dev-portal で OAuth Application を作成
# 2. Redirect URL に http://localhost:8080/callback を設定
# 3. このファイルを .env にコピーして値を記入
#    cp .env.example .env

ONSHAPE_CLIENT_ID=replace_with_your_client_id
ONSHAPE_CLIENT_SECRET=replace_with_your_client_secret
